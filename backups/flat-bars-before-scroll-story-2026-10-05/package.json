{
  "name": "industrial-supply-63-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:preview-widget && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:source": "vite --mode source --host 0.0.0.0 --port 4174",
    "build:source": "npm run build:preview-widget && vite build --mode source --outDir dist-source",
    "build:preview-widget": "esbuild src/flatbar-preview-widget.js --bundle --minify --format=iife --target=es2020 --outfile=public/flatbar-preview-widget.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "framer-motion": "^12.15.0",
    "lenis": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "3.4.17",
    "vite": "^6.3.5"
  }
}
